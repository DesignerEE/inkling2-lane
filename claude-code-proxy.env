# claude-code-proxy environment (copy to ccp/.env next to server.py).
# Maps every Claude Code model name (opus/sonnet/haiku) to the local ingine model.
PREFERRED_PROVIDER=openai
OPENAI_API_KEY=local
OPENAI_BASE_URL=http://127.0.0.1:8004/v1
BIG_MODEL=inkling-2-mini-abliterated
SMALL_MODEL=inkling-2-mini-abliterated
PORT=3456
